+class _BackoffRequests:
+    """LOCAL CHANGE (not in upstream): `requests.get/post` below retry 429 and 5xx replies with exponential backoff
+    (2, 4, 8, ... up to 120 s, plus jitter; a Retry-After header is honoured), up to 8 tries. Everything else is `requests`."""
+
+    RETRY = (429, 500, 502, 503, 504)
+
+    def __getattr__(self, name):
+        return getattr(_requests, name)
+
+    def _send(self, method, *args, **kwargs):
+        for attempt in range(8):
+            response = getattr(_requests, method)(*args, **kwargs)
+            if response.status_code not in self.RETRY or attempt == 7:
+                return response
+            retry_after = response.headers.get("Retry-After", "")
+            wait = float(retry_after) if retry_after.replace(".", "", 1).isdigit() else min(120, 2 ** (attempt + 1))
+            wait += random.random()
+            print(f"[backoff] HTTP {response.status_code} from {args[0] if args else ''}; retry {attempt + 1}/7 in {wait:.1f}s", flush=True)
+            time.sleep(wait)
+
+    def get(self, *args, **kwargs):
+        return self._send("get", *args, **kwargs)
+
+    def post(self, *args, **kwargs):
+        return self._send("post", *args, **kwargs)
+
+
+requests = _BackoffRequests()
